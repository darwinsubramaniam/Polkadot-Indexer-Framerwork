# Build artifacts
/target/

# Fetched by scripts/fetch-zombie-cli.sh — a 40MB prebuilt binary, not source.
/bin/

# Spawned network state from `just zn-up`.
/.zombienet/

# The local block archive. Unanchored on purpose: `hot_path` resolves against the config
# file, so the default lands beside whichever config was used. Tens of gigabytes on a real
# chain, and re-fetchable — it is a cache of what the chain already holds.
.pif-store/

# Local environment overrides
.env

# macOS
.DS_Store

# Chain specs fetched by scripts/fetch-chain-specs.sh — generated, ~300KB each.
/config/specs/
